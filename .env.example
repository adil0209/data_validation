# Copy this file to .env and fill in real values. Never commit .env.

# Azure Data Lake Storage Gen2 account (must have hierarchical namespace enabled)
AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount
AZURE_STORAGE_CONTAINER=validation-results

# Service Principal (App Registration) credentials used for OAuth auth to ADLS Gen2.
# The service principal needs "Storage Blob Data Contributor" on the storage account/container.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me
